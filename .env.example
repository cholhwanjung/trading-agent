# 이 파일을 .env로 복사해 실제 값 기입 (.env는 gitignore됨 — 커밋 금지)
# 발급 방법: 각 브로커 개발자 포털 참고

# --- 크립토 시세·연구 데이터 (Binance — 공개 API라 키 없이도 조회됨) ---
# 아래 Upbit 키가 없을 때만 체결 계좌로도 쓰인다(Binance Spot Testnet, 가상 잔고).
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# --- 크립토 실계좌 (Upbit Open API — 실자금 KRW 마켓 체결) ---
# 채우면 CRYPTO 체결이 testnet 대신 Upbit 실계좌로 전환된다. 관측·시세는 그대로 Binance
# 공개 USDT 채널을 쓰고 주문·잔고만 KRW 마켓이다(배분은 비율이라 통화에 무관).
# 발급: 업비트 → 마이페이지 → Open API 관리. 자산조회·주문 권한만 체크하고 **출금 권한은 끈다**
# (출금은 이체 계층의 별도 키·별도 가드 소관). 허용 IP 등록 필수.
UPBIT_API_KEY=
UPBIT_SECRET=

# --- 미국 주식 (Alpaca Paper — US 뉴스·시세 원천, 체결은 KIS 실전) ---
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET=

# --- 한국 주식 (KIS 모의투자) ---
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT=

# --- KIS 실전 (실자금 — KR 국내 + US 해외주식 겸용, 통합증거금) ---
# 실전 앱키로 국내(KR)와 해외(US) 모두 주문. 계좌는 8자리-2자리(예: 12345678-01).
# 통합증거금이라 원화 담보로 US 매수 가능 — 사전 USD 환전 불필요(어댑터가 환전이후주문가능금액 사용).
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT=

# --- 실계좌 안전 게이트 (실자금 주문 경로 전용) ---
# 1회/일일 주문 명목 상한 — 비율 리스크 레이어가 못 막는 절대 금액 보완. 상한은 그 계좌가
# 주문하는 통화 단위로 해석된다(KIS 해외=USD, KIS 국내·Upbit=KRW) — 어댑터별로 따로 잡는다.
# 상한을 넘는 매수는 축소가 아니라 통째로 스킵된다. 정상 배분 1건(순자산 × 종목당 상한)보다
# 낮게 잡으면 매수가 조용히 멈춘다.
# **매도에는 상한이 없다** — 매도 수량의 상한은 보유량 자체이고 잘못 나가도 결과는 현금이라
# 원금을 잃는 방향이 아니다. 반대로 상한이 매도를 막으면 위험을 줄이려는 순간에 그것을 못 한다.
# kill switch: `touch data/state/KILL_SWITCH` 로 전 실주문 즉시 정지(파일 삭제로 해제).
LIVE_MAX_ORDER_USD=200
LIVE_MAX_DAILY_USD=500
# 크립토(Upbit) 원화 상한
LIVE_MAX_ORDER_KRW=300000
LIVE_MAX_DAILY_KRW=700000
# 국내주식(KIS) 원화 상한 — 같은 원화라도 계좌·주문 크기가 달라 따로 둔다
LIVE_MAX_ORDER_KR_KRW=500000
LIVE_MAX_DAILY_KR_KRW=1000000

# 평가액 대비 1회 매수 상한(비중, 0~1). 설정하면 실제 상한 = min(위 절대 천장, 평가액 × 이 값).
# 위 절대값만 쓰면 입금할 때마다 사람이 다시 정해야 하고, 비율만 쓰면 계좌가 커질수록 한 건의
# 피해 규모가 같이 커진다. 둘 중 작은 값이라 계좌가 작을 때도 보호되고 커져도 천장이 남는다.
# 평가액은 매 스텝 브로커에서 직접 읽으므로 입금·출금·손익이 자동 반영된다.
# 값이 곧 '하루에 옮길 수 있는 최대 비중'이다(0.20 = 20%p). 미설정·범위 밖이면 천장만 적용.
# LIVE_MAX_ORDER_PCT_KR=0.20
# LIVE_MAX_ORDER_PCT_US=0.20
# LIVE_MAX_ORDER_PCT_CRYPTO=0.20
# 실패/거부/MDD 서킷 push 웹훅 (Slack 또는 Discord incoming webhook URL). 비우면 로그만.
ALERT_WEBHOOK_URL=

# --- LLM (멀티 프로바이더 — 하나 이상 설정) ---
# tier 지정: "provider:model". provider ∈ anthropic|openai|gemini|deepseek|openrouter|xai|ollama
LLM_SMART=anthropic:claude-sonnet-5
LLM_FAST=anthropic:claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1  # 로컬 모델 (키 불필요)

# --- 데이터 피드 ---
FRED_API_KEY=
DART_API_KEY=
# SEC EDGAR 는 키가 아니라 연락 가능한 식별자를 요구함(자동 조회 공정 접근 정책).
# 형식: "회사·용도 이메일". 미설정이어도 조회는 되지만 본인 연락처를 넣는 편이 안전함.
SEC_USER_AGENT=

# --- 관측 윈도우 (실험 변수 — 미설정 시 기본값) ---
# 트레이더가 보는 원시 최근 봉 = 최근 N '거래일'(요일·휴장 무관 일정). 기본 3.
# OBSERVATION_TRADING_DAYS=3
# 뉴스 관측 = 최근 N 캘린더일(봉 창과 독립). 기본 7.
# OBSERVATION_NEWS_DAYS=7

# --- Chat Gateway (비우면 인증 없음 — 로컬 단독) ---
INTERACTION_API_TOKEN=
